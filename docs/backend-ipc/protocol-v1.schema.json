{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://com.lloydME.Prism/schemas/backend-protocol/v1/message.json",
  "title": "Prism Backend Protocol v1 JSON-RPC message",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/notification" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "method": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$",
      "maxLength": 128
    },
    "params": {
      "type": "object",
      "maxProperties": 128
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/identifier" },
        "method": { "$ref": "#/$defs/method" },
        "params": { "$ref": "#/$defs/params" }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "event.publish" },
        "params": { "$ref": "#/$defs/event" }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/identifier" },
        "result": {}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "error": { "$ref": "#/$defs/error" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer", "minimum": -32768, "maximum": -32000 },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "data": {
          "type": "object",
          "properties": {
            "domainCode": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "maxLength": 128
            },
            "retry": {
              "enum": ["never", "immediate", "backoff", "after_refresh", "after_prompt", "after_reconnect"]
            },
            "diagnosticId": { "$ref": "#/$defs/uuid" },
            "localization": { "$ref": "#/$defs/localization" },
            "details": { "type": "object", "maxProperties": 64 }
          },
          "required": ["domainCode", "retry", "diagnosticId"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "localization": {
      "type": "object",
      "required": ["key", "arguments"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "arguments": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 1024 },
          "maxProperties": 32
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["backendEpoch", "sequence", "occurredAt", "topic", "event", "data"],
      "properties": {
        "backendEpoch": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/decimal" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "topic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "event": { "$ref": "#/$defs/method" },
        "aggregateId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "aggregateRevision": { "$ref": "#/$defs/decimal" },
        "data": { "type": "object", "maxProperties": 128 }
      },
      "dependentRequired": {
        "aggregateId": ["aggregateRevision"],
        "aggregateRevision": ["aggregateId"]
      },
      "additionalProperties": false
    }
  }
}
